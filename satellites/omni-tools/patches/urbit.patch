diff --git a/src/iconify-offline.ts b/src/iconify-offline.ts
new file mode 100644
index 0000000..81e90da
--- /dev/null
+++ b/src/iconify-offline.ts
@@ -0,0 +1,11 @@
+// urbit: icons are bundled at build time (src/iconify-offline-data.ts, generated by
+// satellites/omni-tools/scripts/offline-icons.mjs) instead of being fetched from
+// api.iconify.design at runtime.
+import { addCollection, setCustomIconsLoader } from '@iconify/react';
+import collections from './iconify-offline-data';
+
+for (const c of collections) {
+  addCollection(c);
+  // an icon missing from the bundle renders empty instead of going to the network
+  setCustomIconsLoader(() => null, c.prefix);
+}
