--- /dev/null
+++ b/src/lib/util/base.ts
@@ -0,0 +1,9 @@
+import { base } from "$app/paths";
+
+// VERT is served under a sub-path on Urbit (e.g. /vert). These helpers
+// prefix/strip that base for internal root-relative URLs.
+export const withBase = (path: string): string =>
+	path.startsWith("/") && !path.startsWith("//") ? `${base}${path}` : path;
+
+export const stripBase = (path: string): string =>
+	base && path.startsWith(base) ? path.slice(base.length) || "/" : path;
