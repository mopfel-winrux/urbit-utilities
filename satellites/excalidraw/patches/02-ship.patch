@@ -0,0 +1,194 @@
+// Client for the %utilities hub storage API (kit/CONTRACT.md), same origin,
+// authenticated by the ship's login cookie.
+//   GET    /utilities/api/store/excalidraw/?prefix=<dir>/   list
+//   GET    /utilities/api/store/excalidraw/<path>           read
+//   PUT    /utilities/api/store/excalidraw/<path>           write
+//          (x-utilities-public: true -> readable at /utilities/pub/...)
+//          If-Match: <etag> -> 412 unless the item is still that version
+//          If-None-Match: * -> 412 if the item exists (create only)
+//   GET/PUT responses carry the item's strong ETag
+//   DELETE /utilities/api/store/excalidraw/<path>           delete
+//   GET    /utilities/pub/excalidraw/<path>                 public read, no login
+
+export const DESK = "excalidraw";
+const API = `/utilities/api/store/${DESK}/`;
+const PUB = `/utilities/pub/${DESK}/`;
+
+export const DRAWINGS_DIR = "drawings/";
+export const SHARED_DIR = "shared/";
+export const EXT = ".excalidraw";
+export const MIME = "application/vnd.excalidraw+json";
+
+export type StoreItem = {
+  path: string;
+  type: string;
+  size: number;
+  modified: number;
+  public: boolean;
+  burn: boolean;
+  expires: number | null;
+};
+
+export const encodePath = (path: string) =>
+  path.split("/").map(encodeURIComponent).join("/");
+
+const fail = async (res: Response, what: string): Promise<never> => {
+  if (res.status === 401 || res.status === 403) {
+    throw new Error(`${what}: not logged in to your ship`);
+  }
+  throw new Error(`${what}: ${res.status} ${res.statusText}`);
+};
+
+export const listItems = async (prefix: string): Promise<StoreItem[]> => {
+  const res = await fetch(`${API}?prefix=${encodeURIComponent(prefix)}`, {
+    credentials: "same-origin",
+    cache: "no-store",
+  });
+  if (!res.ok) {
+    return fail(res, "list");
+  }
+  const rows = (await res.json()) as StoreItem[];
+  return rows.filter((r) => r.path.startsWith(prefix));
+};
+
+/** the item was changed (If-Match) or already exists (If-None-Match: *) */
+export class ConflictError extends Error {
+  constructor(public path: string) {
+    super(`"${nameFromPath(path)}" was changed on your ship`);
+  }
+}
+
+export const getItem = async (
+  path: string,
+): Promise<{ blob: Blob; etag: string | null }> => {
+  const res = await fetch(API + encodePath(path), {
+    credentials: "same-origin",
+    cache: "no-store",
+  });
+  if (!res.ok) {
+    return fail(res, "open");
+  }
+  return { blob: await res.blob(), etag: res.headers.get("etag") };
+};
+
+/** current ETag of an item, or null if it doesn't exist */
+export const headItem = async (path: string): Promise<string | null> => {
+  const res = await fetch(API + encodePath(path), {
+    method: "HEAD",
+    credentials: "same-origin",
+    cache: "no-store",
+  });
+  if (res.status === 404) {
+    return null;
+  }
+  if (!res.ok) {
+    return fail(res, "check");
+  }
+  return res.headers.get("etag");
+};
+
+export type PutCondition =
+  /** only if the item is still this version */
+  | { ifMatch: string }
+  /** only if the item doesn't exist yet */
+  | { create: true }
+  /** unconditional */
+  | null;
+
+/** PUT; throws ConflictError on 412. Returns the new item's ETag. */
+export const putItem = async (
+  path: string,
+  body: string,
+  opts: { public?: boolean; cond?: PutCondition } = {},
+): Promise<{ etag: string | null }> => {
+  const headers: Record<string, string> = { "content-type": MIME };
+  if (opts.public) {
+    headers["x-utilities-public"] = "true";
+  }
+  const cond = opts.cond;
+  if (cond && "ifMatch" in cond) {
+    headers["if-match"] = cond.ifMatch;
+  } else if (cond && "create" in cond) {
+    headers["if-none-match"] = "*";
+  }
+  const res = await fetch(API + encodePath(path), {
+    method: "PUT",
+    credentials: "same-origin",
+    headers,
+    body,
+  });
+  if (res.status === 412) {
+    await res.arrayBuffer().catch(() => undefined);
+    throw new ConflictError(path);
+  }
+  if (!res.ok) {
+    return fail(res, "save");
+  }
+  await res.arrayBuffer().catch(() => undefined);
+  // the hub sends the new ETag; ask for it if a proxy dropped it
+  return { etag: res.headers.get("etag") ?? (await headItem(path)) };
+};
+
+export const deleteItem = async (path: string): Promise<void> => {
+  const res = await fetch(API + encodePath(path), {
+    method: "DELETE",
+    credentials: "same-origin",
+  });
+  // drain the (empty) body so the request completes cleanly
+  await res.arrayBuffer().catch(() => undefined);
+  if (!res.ok && res.status !== 404) {
+    return fail(res, "delete");
+  }
+};
+
+export const publicUrl = (path: string) =>
+  `${window.location.origin}${PUB}${encodePath(path)}`;
+
+/** read-only viewer page, public sub-path of this desk */
+export const viewerUrl = (path: string) =>
+  `${window.location.origin}/${DESK}/view/#${encodePath(path)}`;
+
+export const fetchPublic = async (path: string): Promise<Blob> => {
+  const res = await fetch(PUB + encodePath(path), {
+    credentials: "omit",
+    cache: "no-store",
+  });
+  if (!res.ok) {
+    throw new Error(
+      res.status === 404
+        ? "This drawing doesn't exist or is no longer shared."
+        : `Couldn't load the drawing (${res.status}).`,
+    );
+  }
+  return res.blob();
+};
+
+/** drawing name -> store path; names keep their spelling, minus separators */
+export const cleanName = (name: string) =>
+  name
+    .replace(/[\\/\u0000-\u001f\u007f]+/g, " ")
+    .replace(/\.excalidraw$/i, "")
+    .replace(/^\.+/, "")
+    .trim()
+    .slice(0, 120);
+
+export const drawingPath = (name: string) => DRAWINGS_DIR + cleanName(name) + EXT;
+
+export const nameFromPath = (path: string) =>
+  path.slice(path.lastIndexOf("/") + 1).replace(/\.excalidraw$/, "");
+
+export const randomId = () => {
+  const b = new Uint8Array(12);
+  crypto.getRandomValues(b);
+  return Array.from(b, (x) => x.toString(16).padStart(2, "0")).join("");
+};
+
+export const sharePath = (name: string) => {
+  const slug =
+    cleanName(name)
+      .toLowerCase()
+      .replace(/[^a-z0-9]+/g, "-")
+      .replace(/^-+|-+$/g, "")
+      .slice(0, 40) || "drawing";
+  return `${SHARED_DIR}${slug}-${randomId()}${EXT}`;
+};
