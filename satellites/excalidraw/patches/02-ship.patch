+// Minimal read-only viewer for drawings shared from the ship. Public route
+// (/excalidraw/view/ is a public sub-path of the desk): no login, no local
+// storage, no ship API besides the public read
+//   GET /utilities/pub/excalidraw/<path>
+// The path is in the URL fragment: /excalidraw/view/#shared/<name>.excalidraw
+import { StrictMode, useEffect, useState } from "react";
+import { createRoot } from "react-dom/client";
+import { Excalidraw, MainMenu, loadFromBlob } from "@excalidraw/excalidraw";
+import type { ExcalidrawInitialDataState } from "@excalidraw/excalidraw/types";
+import { fetchPublic } from "../ship/api";
+
+const pathFromHash = () => {
+  let p = window.location.hash.replace(/^#/, "");
+  try {
+    p = decodeURIComponent(p);
+  } catch {
+    return null;
+  }
+  return /^shared\/[^/]+\.excalidraw$/.test(p) ? p : null;
+};
+
+const Viewer = () => {
+  const [state, setState] = useState<
+    | { kind: "loading" }
+    | { kind: "error"; message: string }
+    | { kind: "ready"; data: ExcalidrawInitialDataState; name: string }
+  >({ kind: "loading" });
+
+  useEffect(() => {
+    const path = pathFromHash();
+    if (!path) {
+      setState({ kind: "error", message: "No shared drawing in this link." });
+      return;
+    }
+    (async () => {
+      try {
+        const blob = await fetchPublic(path);
+        const data = await loadFromBlob(blob, null, null);
+        const name = data.appState.name || "Shared drawing";
+        document.title = `${name} · Excalidraw (read-only)`;
+        setState({
+          kind: "ready",
+          name,
+          data: {
+            elements: data.elements,
+            files: data.files,
+            appState: {
+              viewBackgroundColor: data.appState.viewBackgroundColor,
+              name,
+            },
+            scrollToContent: true,
+          },
+        });
+      } catch (e: any) {
+        setState({ kind: "error", message: e.message || String(e) });
+      }
+    })();
+  }, []);
+
+  if (state.kind === "loading") {
+    return <div className="view-message">Loading drawing…</div>;
+  }
+  if (state.kind === "error") {
+    return (
+      <div className="view-message" data-testid="view-error">
+        {state.message}
+      </div>
+    );
+  }
+  return (
+    <div
+      style={{ height: "100%" }}
+      data-testid="viewer"
+      data-elements={
+        (state.data.elements || []).filter((e) => !e.isDeleted).length
+      }
+    >
+      <Excalidraw
+        initialData={state.data}
+        viewModeEnabled={true}
+        zenModeEnabled={false}
+        name={state.name}
+        UIOptions={{
+          canvasActions: {
+            changeViewBackgroundColor: false,
+            clearCanvas: false,
+            export: false,
+            loadScene: false,
+            saveToActiveFile: false,
+            saveAsImage: true,
+            toggleTheme: true,
+          },
+          tools: { image: false },
+        }}
+      >
+        <MainMenu>
+          <MainMenu.DefaultItems.SaveAsImage />
+          <MainMenu.DefaultItems.ToggleTheme />
+          <MainMenu.DefaultItems.Help />
+        </MainMenu>
+      </Excalidraw>
+    </div>
+  );
+};
+
+createRoot(document.getElementById("root")!).render(
+  <StrictMode>
+    <Viewer />
+  </StrictMode>,
+);
